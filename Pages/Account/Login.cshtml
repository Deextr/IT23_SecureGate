@page
@model SecureGate1.Pages.Account.LoginModel
@using SecureGate1.Services
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<h1 class="auth-title-center">Sign in</h1>
@if (Model.ShowLockout)
{
    <div class="sg-banner sg-banner-error" role="alert">
        <p><strong>@SignInMessages.LockoutTitle</strong></p>
        <p>@SignInMessages.LockoutBody</p>
    </div>
}
else if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="sg-banner sg-banner-error" role="alert">@Model.Error</div>
}
<form method="post" class="auth-form" novalidate>
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
    <div class="sg-field sg-field--float">
        <div class="sg-float">
            <input class="sg-input" asp-for="Email" type="email" inputmode="email" autocomplete="email" placeholder=" " />
            <label class="sg-float__label" asp-for="Email">Email</label>
        </div>
        <span asp-validation-for="Email" class="field-validation-error"></span>
    </div>
    <div class="sg-field sg-field--float">
        <div class="sg-float sg-float--password">
            <input class="sg-input" asp-for="Password" type="password" autocomplete="current-password" placeholder=" " />
            <label class="sg-float__label" asp-for="Password">Password</label>
            <button
                class="sg-password-toggle"
                type="button"
                data-toggle-password="Password"
                aria-label="Show password"
                aria-pressed="false"
                title="Show password">
                <svg class="sg-icon" data-icon-show viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M2.2 12s3.4-6.2 9.8-6.2 9.8 6.2 9.8 6.2-3.4 6.2-9.8 6.2S2.2 12 2.2 12z" />
                    <circle cx="12" cy="12" r="2.8" />
                </svg>
                <svg class="sg-icon" data-icon-hide viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                    <path d="M3.3 3.3l17.4 17.4M10.7 10.9a2.8 2.8 0 0 0 3.9 3.9" />
                    <path d="M9.9 5.8A10.2 10.2 0 0 1 12 5.5c6.4 0 9.8 6.5 9.8 6.5a16.5 16.5 0 0 1-4.1 4.6M6.7 6.7A16.3 16.5 0 0 0 2.2 12s3.4 6.5 9.8 6.5c1.1 0 2.1-.2 3.1-.5" />
                </svg>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-validation-error"></span>
    </div>
    <button class="sg-btn" type="submit" data-submit>Sign in</button>
</form>
<p class="sg-help auth-footer"><a asp-page="/Privacy">Privacy</a></p>
