@page
@model SecureGate1.Pages.Account.FirstSignInPasswordModel
@{
    ViewData["Title"] = "New password";
    Layout = "_AuthLayout";
}
<h1>New password</h1>
<p class="sg-help">Use 12 to 128 characters. You will still set up an authenticator.</p>
<form method="post" class="auth-form">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
    <div class="sg-field sg-field--float">
        <div class="sg-float">
            <input class="sg-input" asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder=" " />
            <label class="sg-float__label" asp-for="CurrentPassword">Temporary password</label>
        </div>
    </div>
    <div class="sg-field sg-field--float">
        <div class="sg-float">
            <input class="sg-input" asp-for="NewPassword" type="password" autocomplete="new-password" placeholder=" " />
            <label class="sg-float__label" asp-for="NewPassword">New password</label>
        </div>
    </div>
    <div class="sg-field sg-field--float">
        <div class="sg-float">
            <input class="sg-input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder=" " />
            <label class="sg-float__label" asp-for="ConfirmPassword">Confirm password</label>
        </div>
    </div>
    <button class="sg-btn" type="submit" data-submit>Save</button>
</form>
