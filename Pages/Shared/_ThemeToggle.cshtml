<button class="sg-theme-toggle" type="button" data-theme-toggle role="switch" aria-checked="false" aria-label="Appearance: light mode. Activate to switch to dark mode." title="Switch to dark mode">
    <span class="sg-theme-toggle__state sg-theme-toggle__state--light" aria-hidden="true">
        <vc:sg-icon name="sun" />
    </span>
    <span class="sg-theme-toggle__state sg-theme-toggle__state--dark" aria-hidden="true">
        <vc:sg-icon name="moon" />
    </span>
</button>
