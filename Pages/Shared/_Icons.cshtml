@*
    Compact inline SVG set for navigation and a few actions.
    One style: 24px stroke icons, currentColor, no emoji and no extra CSS library.
*@
@{
    var name = (string)(ViewData["Icon"] ?? "");
    var css = (string)(ViewData["Class"] ?? "sg-icon");
}
<svg class="@css" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
@switch (name)
{
    case "dashboard":
        <path d="M4 4h7v9H4zM13 4h7v5h-7zM13 11h7v9h-7zM4 15h7v5H4z" />
        break;
    case "security":
        <path d="M12 3l8 3v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z" />
        <path d="M9.2 12.2l1.9 1.9 3.7-4.1" />
        break;
    case "users":
        <path d="M16 19v-1.2A3.8 3.8 0 0 0 12.2 14H7.8A3.8 3.8 0 0 0 4 17.8V19" />
        <circle cx="10" cy="8" r="3" />
        <path d="M20 19v-1.1A3.2 3.2 0 0 0 17.4 15" />
        <circle cx="17" cy="8.5" r="2.2" />
        break;
    case "reset":
        <path d="M4 12a8 8 0 1 0 2.3-5.7" />
        <path d="M4 4v5h5" />
        break;
    case "settings":
        <circle cx="12" cy="12" r="3" />
        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
        break;
    case "audit":
        <path d="M8 4h8a2 2 0 0 1 2 2v14H6V6a2 2 0 0 1 2-2z" />
        <path d="M9 9h6M9 13h6M9 17h4" />
        break;
    case "alerts":
        <path d="M12 4a6 6 0 0 1 6 6c0 4 1.5 5.5 1.5 5.5H4.5S6 14 6 10a6 6 0 0 1 6-6z" />
        <path d="M10 19a2 2 0 0 0 4 0" />
        break;
    case "investigate":
        <circle cx="10.5" cy="10.5" r="6" />
        <path d="M15 15l5 5" />
        break;
    case "menu":
        <path d="M4 7h16M4 12h16M4 17h16" />
        break;
    case "close":
        <path d="M6 6l12 12M18 6L6 18" />
        break;
    default:
        <circle cx="12" cy="12" r="8" />
        break;
}
</svg>
