@{
    var fieldId = (string)(ViewData["FieldId"] ?? "Password");
    var fieldName = (string)(ViewData["FieldName"] ?? fieldId);
    var label = (string)(ViewData["Label"] ?? "Password");
    var autocomplete = (string)(ViewData["Autocomplete"] ?? "current-password");
}
<div class="sg-field sg-field-compact">
    <label class="sg-label" for="@fieldId">@label</label>
    <div class="sg-input-password">
        <input class="sg-input" id="@fieldId" name="@fieldName" type="password" autocomplete="@autocomplete" />
        <button
            class="sg-password-toggle"
            type="button"
            data-toggle-password="@fieldId"
            aria-label="Show password"
            aria-pressed="false"
            title="Show password">
            <svg class="sg-icon" data-icon-show viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M2.2 12s3.4-6.2 9.8-6.2 9.8 6.2 9.8 6.2-3.4 6.2-9.8 6.2S2.2 12 2.2 12z" />
                <circle cx="12" cy="12" r="2.8" />
            </svg>
            <svg class="sg-icon" data-icon-hide viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
                <path d="M3.3 3.3l17.4 17.4M10.7 10.9a2.8 2.8 0 0 0 3.9 3.9" />
                <path d="M9.9 5.8A10.2 10.2 0 0 1 12 5.5c6.4 0 9.8 6.5 9.8 6.5a16.5 16.5 0 0 1-4.1 4.6M6.7 6.7A16.3 16.3 0 0 0 2.2 12s3.4 6.5 9.8 6.5c1.1 0 2.1-.2 3.1-.5" />
            </svg>
        </button>
    </div>
</div>
